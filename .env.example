# ============================================================
# ASIA-BOT — environment template
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง:  cp .env.example .env.local
# หลังแก้ env ต้อง restart dev server หรือ redeploy ก่อนค่าจะมีผล
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_NAME=ASIA-BOT
NEXT_PUBLIC_SITE_URL=https://asia-bot.xyz

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# server-only — ห้าม prefix ด้วย NEXT_PUBLIC_ เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Session (Phase 1) ---
# ใช้เซ็น session token (HMAC-SHA256) จำเป็นต้องตั้งค่า
# สร้างด้วย:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=

# ยอมรับ header x-admin-id แบบเดิมควบคู่กับ session cookie
# 1 = เปิด (ค่าเริ่มต้นของ Phase 1 เพื่อไม่ให้ระบบเดิมพัง)
# 0 = ปิด — ใช้เฉพาะ signed cookie เท่านั้น (เป้าหมายของ Phase 14)
AUTH_LEGACY_HEADER=1

# --- Admin fallback / auth (break-glass) ---
ADMIN_PASSWORD=optional_env_admin_password
ADMIN_FALLBACK_USERNAME=optional_superadmin_username
ADMIN_FALLBACK_PASSWORD=optional_superadmin_password
ADMIN_SECRET=optional_setup_or_recovery_secret

# --- LINE ---
LINE_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_GROUP_ADMIN=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_GROUP_ATTEND=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- RFID (ESP32) ---
RFID_STATION_SECRET=optional_station_secret

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AI Agent (ASIA-BOT AI) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Firebase public config (optional; defaults exist in src/lib/firebase.ts) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
