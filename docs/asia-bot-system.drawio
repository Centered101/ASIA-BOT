    <diagram id="asia-bot-schema" name="ภาพรวมฐานข้อมูล">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="schema-title" value="ภาพรวมฐานข้อมูล ASIA-BOT" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#0F172A;align=center;" parent="1" vertex="1">
                    <mxGeometry x="540" y="30" width="720" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="students-table" value="students - ข้อมูลนักเรียน&#xa;────────────&#xa;student_id: รหัสนักเรียน&#xa;first_name / last_name: ชื่อ-นามสกุล&#xa;nickname / program: ชื่อเล่น / ระดับ&#xa;department / entry_year: สาขา / ปีที่เข้า&#xa;uid: รหัสบัตร RFID&#xa;card_status: สถานะบัตร&#xa;photo_url: รูปนักเรียน&#xa;line_user_id: LINE นักเรียน&#xa;google_email / google_id: บัญชี Google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7FF;strokeColor=#84D4FA;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="70" y="150" width="260" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="admins-table" value="admins - ผู้ดูแลระบบ&#xa;────────────&#xa;admin_id: รหัสผู้ดูแล&#xa;username: ชื่อผู้ใช้&#xa;password_hash: รหัสผ่านที่เข้ารหัส&#xa;role: superadmin / admin / staff&#xa;avatar: รูปผู้ดูแล&#xa;admin_status: สถานะบัญชี&#xa;linked_student_id: ผูกกับนักเรียน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFECEC;strokeColor=#FF7070;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="70" y="470" width="260" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="attendance-table" value="attendance / attendance_logs&#xa;บันทึกสแกนเข้า-ออก&#xa;────────────&#xa;student_id: รหัสนักเรียน&#xa;uid: รหัสบัตร RFID&#xa;location: จุดเช็กชื่อ&#xa;checkin_time / check_in: เวลาเข้า&#xa;checkout_time / check_out: เวลาออก&#xa;duration / duration_minutes: ระยะเวลา&#xa;date: วันที่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#22C55E;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="120" width="285" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="requests-table" value="change_requests / name_change_requests&#xa;คำขอแก้ไขข้อมูลนักเรียน&#xa;────────────&#xa;student_id: รหัสนักเรียน&#xa;requested_changes: รายการที่ขอแก้&#xa;old/new names: ชื่อเดิม / ชื่อใหม่&#xa;status: สถานะคำขอ&#xa;admin_note: หมายเหตุผู้ดูแล&#xa;reviewed_by: ผู้ตรวจสอบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="390" width="285" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="bookings-table" value="rooms / bookings / time_slots&#xa;ห้องเรียนและการจองห้อง&#xa;────────────&#xa;rooms.id: รหัสห้อง&#xa;bookings.room_id: ห้องที่จอง&#xa;bookings.student_id: ผู้จอง&#xa;slot_id: ช่วงเวลา&#xa;booking_date: วันที่จอง&#xa;attendees: จำนวนคน&#xa;status / admin_note: สถานะ / หมายเหตุ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="650" width="285" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="shop-table" value="products / orders&#xa;สหกรณ์โรงเรียน&#xa;────────────&#xa;products.id: รหัสสินค้า&#xa;name / price / stock: ชื่อ / ราคา / คงเหลือ&#xa;images / category: รูป / หมวดหมู่&#xa;orders.order_id: เลขออเดอร์&#xa;orders.student_id: ผู้สั่งซื้อ&#xa;items_json: รายการสินค้า&#xa;total / status: ยอดรวม / สถานะ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="880" y="120" width="285" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="projects-table" value="projects / evaluations&#xa;โปรเจกต์และผลประเมิน&#xa;────────────&#xa;projects.id: รหัสโปรเจกต์&#xa;slug: ลิงก์โปรเจกต์&#xa;project_date: วันที่/ปีโปรเจกต์&#xa;poster / logo / mascot: รูปประกอบ&#xa;custom_fields: คำถามเพิ่มเติม&#xa;evaluations.project_id: โปรเจกต์ที่ประเมิน&#xa;scores + comments: คะแนนและความคิดเห็น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="880" y="410" width="285" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="school-table" value="class_groups / schedules / overrides / teachers&#xa;ตารางเรียนและครูผู้สอน&#xa;────────────&#xa;class_group_id: กลุ่มเรียน&#xa;room_name: ชื่อห้องเรียน&#xa;teacher: ครูผู้สอน&#xa;day_of_week: วันในสัปดาห์&#xa;start_time / end_time: เวลาเริ่ม / จบ&#xa;override_date: วันพิเศษ&#xa;teachers เป็นข้อมูลครู ไม่ใช่สิทธิ์ผู้ใช้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0EA5E9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="880" y="690" width="285" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="feedback-table" value="feedback&#xa;ความคิดเห็นและรายงานปัญหา&#xa;────────────&#xa;type: ประเภทเรื่อง&#xa;name: ชื่อผู้ส่ง&#xa;student_id: รหัสนักเรียน&#xa;email / contact: ช่องทางติดต่อ&#xa;category: หมวดหมู่&#xa;message: ข้อความ&#xa;image_urls: รูปแนบ&#xa;status / admin_note: สถานะ / หมายเหตุ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FF7070;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="250" width="260" height="210" as="geometry"/>
