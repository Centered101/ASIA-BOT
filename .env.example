# ============================================================
# ASIA-BOT — environment template
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง:  cp .env.example .env.local
# หลังแก้ env ต้อง restart dev server หรือ redeploy ก่อนค่าจะมีผล
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_NAME=ASIA-BOT
NEXT_PUBLIC_SITE_URL=https://asia-bot.xyz

# ทีมผู้พัฒนาที่โชว์ในหน้าแรก — ชื่อผู้ใช้ GitHub คั่นด้วยคอมมา
# ใส่บทบาทต่อท้ายด้วย | ได้ ถ้าไม่ใส่จะใช้ bio จาก GitHub แทน
# (บัญชีที่ไม่ได้เขียน bio ไว้จะขึ้นการ์ดเปล่า ๆ จึงควรใส่บทบาทให้)
# ไม่ตั้งค่า = ใช้ทีมเดิมที่กำหนดไว้ใน src/lib/config.ts
NEXT_PUBLIC_TEAM_GITHUB=Centered101|หัวหน้าทีม, Centered101-dev, Centered102-dev

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# server-only — ห้าม prefix ด้วย NEXT_PUBLIC_ เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Session (Phase 1) ---
# ใช้เซ็น session token (HMAC-SHA256) จำเป็นต้องตั้งค่า
# สร้างด้วย:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=

# ยอมรับ header x-admin-id แบบเดิมควบคู่กับ session cookie
# 1 = เปิด (ค่าเริ่มต้นของ Phase 1 เพื่อไม่ให้ระบบเดิมพัง)
# 0 = ปิด — ใช้เฉพาะ signed cookie เท่านั้น (เป้าหมายของ Phase 14)
AUTH_LEGACY_HEADER=1

# --- Admin fallback / auth (break-glass) ---
ADMIN_PASSWORD=optional_env_admin_password
ADMIN_FALLBACK_USERNAME=optional_superadmin_username
ADMIN_FALLBACK_PASSWORD=optional_superadmin_password
ADMIN_SECRET=optional_setup_or_recovery_secret

# --- LINE ---
LINE_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_GROUP_ADMIN=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_GROUP_ATTEND=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ปลายทางแจ้งเตือนงานซ่อม ถ้าไม่ตั้ง จะใช้ LINE_GROUP_ADMIN แทน
LINE_GROUP_MAINTENANCE=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- RFID (ESP32) ---
RFID_STATION_SECRET=optional_station_secret

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AI Agent (ASIA-BOT AI) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Firebase public config (optional; defaults exist in src/lib/firebase.ts) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Mycer (ซับโดเมนแฟ้มสะสมผลงานนักเรียน) ---
# ทุกตัวในบล็อกนี้ "ไม่ต้องตั้งบนเครื่องตัวเอง" ค่าปริยายพาไปที่ /mycer ของแอป
# เดียวกัน ซึ่งใช้งานได้ครบทุกหน้าอยู่แล้ว ตั้งเฉพาะตอน deploy ที่มี DNS จริง
#
# ==> ชื่อแบรนด์ที่ผู้ใช้เห็น แก้ที่ตัวนี้ตัวเดียวเปลี่ยนหมดทั้งซับโดเมน <==
# ขึ้นที่: โลโก้บนแถบบน/แถบข้าง/ท้ายหน้า, หัวเรื่องแท็บทุกหน้า, หัวหน้าล็อกอิน
# ("ยินดีต้อนรับกลับสู่ ..."), ป้ายลิขสิทธิ์ท้ายหน้า และชื่อลิงก์ในเมนูของเว็บหลัก
# ไม่ตั้งก็ใช้ค่า "Mycer"
# NEXT_PUBLIC_MYCER_NAME=Mycer
#
# คำโปรยใต้ชื่อ ใช้เป็น meta description กับ og ของทุกหน้าใน Mycer
# NEXT_PUBLIC_MYCER_DESCRIPTION=
#
# สีประจำแบรนด์ที่ส่งให้เบราว์เซอร์ทาแถบบนตอนเปิดบนมือถือ
# NEXT_PUBLIC_MYCER_THEME_COLOR=#4170e9
#
# ชื่อซับโดเมนที่ middleware ใช้ตัดสินว่าคำขอนี้เป็นของ Mycer
# ตั้งใจแยกจาก NEXT_PUBLIC_MYCER_NAME ข้างบน — ตัวนี้ต้องตรงกับ DNS จริง
# เปลี่ยนชื่อที่แสดงผลจึงต้องไม่ทำให้เส้นทางขยับตาม ไม่งั้นเว็บจะล่มเงียบ ๆ
# ไม่ตั้งก็ใช้ค่า "mycer" (mycer.asia-bot.xyz, mycer.localhost:3000)
# NEXT_PUBLIC_MYCER_SUBDOMAIN=mycer
#
# URL ที่ลิงก์ในหน้าหลักชี้ไป ไม่ตั้งจะชี้ไปที่ /mycer ในแอปเดียวกัน
# NEXT_PUBLIC_MYCER_URL=https://mycer.asia-bot.xyz
#
# ให้ล็อกอินครั้งเดียวใช้ได้ทั้งโดเมนหลักและซับโดเมน
# **ห้ามตั้งบน localhost** เบราว์เซอร์จะทิ้งคุกกี้ที่ระบุโดเมนไม่ตรงกับโฮสต์
# แล้วล็อกอินจะพังเงียบ ๆ (กดเข้าสู่ระบบสำเร็จแต่เด้งกลับหน้าล็อกอินทันที)
# ไม่ตั้ง = คุกกี้ผูกกับโฮสต์เดียว ต้องล็อกอินแยกสองที่
# SESSION_COOKIE_DOMAIN=.asia-bot.xyz

# ลิงก์แอดเพื่อน LINE OA ของโรงเรียน ใช้ทำปุ่มในหน้านักเรียน
# หาได้จาก LINE Official Account Manager > ตั้งค่า > ข้อมูลบัญชี
# ไม่ตั้งก็ได้ หน้าจะแสดงวิธีเชื่อมเป็นข้อความแทนปุ่ม
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
